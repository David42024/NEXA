# Base de datos: usa PostgreSQL en produccion. Por defecto usa SQLite local para desarrollo rapido.
DATABASE_URL=sqlite:///./nexa.db
# Ejemplo Postgres: postgresql://user:pass@localhost:5432/nexa

JWT_SECRET=change_this_secret_in_production
JWT_EXPIRATION_HOURS=8
JWT_REFRESH_EXPIRATION_HOURS=168

# Origenes permitidos por CORS (comma-separated). "*" solo para demo.
CORS_ALLOWED_ORIGINS=*

# Bloqueo temporal de cuenta tras intentos fallidos de login
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

# IA Generativa para speech
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1/chat/completions
FALLBACK_API_KEY=
FALLBACK_PROVIDER=gemini
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

ENVIRONMENT=demo
RATE_LIMIT_PER_MINUTE=50
