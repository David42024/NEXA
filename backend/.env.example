# Base de datos: usa PostgreSQL en produccion. Por defecto usa SQLite local para desarrollo rapido.
DATABASE_URL=sqlite:///./nexa.db
# Ejemplo Postgres local: postgresql://user:pass@localhost:5432/nexa
# Ejemplo Neon (el codigo convierte postgres:// -> postgresql+psycopg2://):
#   postgresql://user:password@ep-xxxx-yyyy-zzzz.us-east-2.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change_this_secret_in_production
JWT_EXPIRATION_HOURS=8
JWT_REFRESH_EXPIRATION_HOURS=168

# Origenes permitidos por CORS (comma-separated). "*" solo para demo.
# En produccion: el dominio del frontend en Vercel, p.ej.
#   CORS_ALLOWED_ORIGINS=https://nexa.vercel.app,https://nexa-git-main-abc.vercel.app
CORS_ALLOWED_ORIGINS=*

# Bloqueo temporal de cuenta tras intentos fallidos de login
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

# IA Generativa para speech
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
FALLBACK_API_KEY=
FALLBACK_PROVIDER=gemini
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent

ENVIRONMENT=demo
RATE_LIMIT_PER_MINUTE=50

# Twilio (llamadas telefonicas reales via PSTN)
# Obtener en: https://console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numero de Twilio comprado (formato: +51XXXXXXXXX para Peru)
TWILIO_PHONE_NUMBER=+51XXXXXXXXX
# URL publica del backend para webhooks de Twilio (usar ngrok en local)
# En produccion: https://tu-backend.onrender.com
TWILIO_VOICE_URL=https://tu-backend.onrender.com/api/twilio/voice
TWILIO_STATUS_URL=https://tu-backend.onrender.com/api/twilio/status
